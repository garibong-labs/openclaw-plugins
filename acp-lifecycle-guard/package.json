{
  "name": "openclaw-acp-lifecycle-guard",
  "version": "0.6.1",
  "description": "OpenClaw plugin that validates ACP lifecycle reports and runs a durable, fenced report-delivery controller.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.22.3"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "smoke:target-build": "node test/smoke/target-build.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "typescript": "5.9.3"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  }
}
